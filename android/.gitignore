gradle-wrapper.jar
/.gradle
/captures/
/gradlew
/gradlew.bat
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# pkg2zip is compiled at build time into app/src/main/jniLibs/<abi>/libpkg2zip.so
# by src/main/cpp/CMakeLists.txt — never a source file, always a build output.
app/src/main/jniLibs/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
# Exception: app/debug.keystore is intentionally committed — a fixed
# debug-signing key so CI release builds are byte-identical across runs
# instead of AGP silently generating a new one on every ephemeral runner.
!app/debug.keystore
